<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Rotating job photos (two layers that crossfade; hidden when no photos) -->
    <ImageView
        android:id="@+id/bg_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />
    <ImageView
        android:id="@+id/bg_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@null" />

    <!-- Dark scrim so logo and tiles stay readable over any photo -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim" />

    <!-- Subtle radial vignette for depth -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette" />

    <!-- Logo, top-center. The PNG is feathered so it melts into the gradient. -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="match_parent"
        android:layout_height="178dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/logo"
        android:contentDescription="@null" />

    <!-- Thin gold rule under the logo -->
    <View
        android:layout_width="110dp"
        android:layout_height="1.5dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="186dp"
        android:background="@color/gold" />

    <!-- Clock + date, top-right -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="48dp"
        android:orientation="vertical"
        android:gravity="end">
        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:fontFamily="sans-serif-light" />
        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textAllCaps="true"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- Rows, anchored to the bottom and filling the width -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="22dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            style="@style/RowLabel"
            android:text="@string/row_watch" />

        <LinearLayout
            android:id="@+id/app_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            style="@style/RowLabel"
            android:layout_marginTop="6dp"
            android:text="@string/row_inputs" />

        <LinearLayout
            android:id="@+id/input_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
